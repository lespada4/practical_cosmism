; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PRACTICAL COSMISM"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

ItemRegistry="*uid://pe8ot1sgm8u7"
BlueprintRegistry="*uid://b1cixqvc7iatw"

[debug]

settings/stdout/print_fps=true

[display]

window/size/mode=3
window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://Global_Scripts/": "pink",
"res://Levels/": "teal",
"res://Object_Models/": "green",
"res://Object_Scenes/": "green",
"res://Objects_Scripts/": "green",
"res://Player/": "pink",
"res://Shaders/": "purple",
"res://Textures/": "purple",
"res://blueprints/": "blue",
"res://blueprints/ghost/": "green",
"res://buildings/": "blue",
"res://items/": "gray"
}

